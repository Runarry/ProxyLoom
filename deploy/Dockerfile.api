FROM --platform=$BUILDPLATFORM node:24.6.0-bookworm-slim@sha256:9b741b28148b0195d62fa456ed84dd6c953c1f17a3761f3e6e6797a754d9edff AS web
WORKDIR /src/proxyloom-web
RUN npm install --global pnpm@10.33.2
COPY proxyloom-web/package.json proxyloom-web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY proxyloom-web/ ./
RUN pnpm typecheck && pnpm build

FROM --platform=$BUILDPLATFORM golang:1.26.8-bookworm@sha256:9fdc884aacc3bec89b20ffc69f4bb369c78210e3e4f600387b5128b12c199f81 AS build
WORKDIR /src
ENV GOTOOLCHAIN=local
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY . .
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -mod=readonly -trimpath -buildvcs=false -o /out/proxyloom-server ./proxyloom-server

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/proxyloom-server /app/proxyloom-server
COPY --from=web /src/proxyloom-web/dist /app/web
USER 10001:10001
ENTRYPOINT ["/app/proxyloom-server"]
CMD ["serve"]
